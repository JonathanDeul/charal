  "protocol": {
    "created": "2026-11-15",
    "purpose": "Controlled retrospective daily MODIS-to-SNPP comparison: architecture versus spatial/temporal context",
    "supervision": "California only; all models use identical daily target rows and quality policy",
    "grid": 0.5,
    "patch": [
      7,
      5,
      5
    ],
    "context": "MODIS within union of five previously prepared western states; +/-3 days, +/-2 grid cells. Center uses state-clipped California measurements. Outside-domain, listed missing days, and dates outside each split have an explicit availability mask and zero-filled values. Availability is not clear-sky exposure.",
    "development_train": [
      2013,
      2018
    ],
    "development_validate": [
      2019,
      2020
    ],
    "final_train": [
      2013,
      2020
    ],
    "selection": [
      2021,
      2022
    ],
    "known_benchmark": [
      2023,
      2025
    ],
    "backward_audit": [
      2012,
      2012
    ],
    "quality": "Evaluate complete paired months only using the original NASA outage policy. Context does not cross split boundaries. All days of an eligible target month are retained.",
    "calfire": "Never a predictor or target. Link records by normalized IRWIN/complex IDs; purge training inputs/labels spatially and temporally associated with a linked event that also touches the audit period. Use final perimeters for descriptive large-event strata only. Missing linkage/dates preclude a guarantee of event independence.",
    "models": [
      "seasonal_ratio",
      "boost_point",
      "boost_context",
      "mlp_poisson",
      "cnn_poisson",
      "cnn_nb",
      "cnn_poisson_aggregate"
    ],
    "seeds": [
      42,
      43,
      44
    ],
    "neural_epoch_candidates": [
      2,
      4,
      8
    ],
    "neural_fit": "AdamW lr 0.001, weight_decay 0.001, batch 2048, CPU threads 4. Small 8-filter spatial convolution over daily channels; residual positive count mean anchored to training seasonal ratio. NB2 learns one global dispersion. Aggregate variant adds 0.1 times squared log1p monthly north/south aggregate disagreement, computed on full eligible train month batches.",
    "boost": "HistGradientBoosting Poisson, 100 iterations, learning rate .05, max_leaf_nodes 15, min_samples_leaf 100, l2 10, no early stopping. Exposure-weighted baseline-offset target.",
    "sampling": "Keep all training rows with local MODIS>0 or VIIRS>0 and a seeded 10% sample of double-zero rows; inverse-probability weights. Same rows for all architectures. Full unsampled evaluation. Monthly aggregate training uses all unpurged rows, not sampled estimates.",
    "selection_rule": "Select epoch for each NN family using ensemble statewide monthly MAE on 2019-2020 only. Refit 2013-2020 with chosen epochs, ensemble three seeds. Select final family by 2021-2022 statewide monthly MAE. Baseline wins ties. Known benchmark and backward audit are computed only after saving selection.",
    "promotion": "Research comparison only; no automatic production change. Report selection cell MAE, north/south monthly MAE, zero-MODIS-daily and zero-MODIS-month strata and >=500 MODIS/month errors alongside primary MAE.",
    "limitations": "All historical evaluation periods have already been inspected. This is an exploratory follow-up, not a pristine independent test. Full observation masks remain unavailable as predictors. Grid and context size are fixed for this first experiment; no benchmark-driven tuning."
  },
