{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run generate",
  "outputDirectory": "frontend/.output/public",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,data/raw/**,data/processed/hotspots.csv,.venv/**,.env,.env.*,scripts/**,tests/**,docs/**}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index.py" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
  ] }]
}
